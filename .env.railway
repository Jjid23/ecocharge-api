# ─────────────────────────────────────────────────────────────────────────────
# Railway environment variables — set these in the Railway dashboard
# Project → Variables tab → paste each one
# ─────────────────────────────────────────────────────────────────────────────

# Railway provides this automatically when you add a PostgreSQL/MySQL plugin.
# For SQL Server you can use the Railway MS SQL plugin or Azure SQL Free Tier.
# Example (Railway MS SQL):
ConnectionStrings__DefaultConnection=Server=YOUR_RAILWAY_MSSQL_HOST,1433;Database=SmartEVChargingDb;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;

# JWT — use a long random string (min 32 chars)
Jwt__Key=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS_LONG
Jwt__Issuer=SmartEVChargingAPI
Jwt__Audience=EcoChargeApp
Jwt__ExpiryMinutes=1440

# ESP32 shared secret
Esp32__Secret=ECOCHARGE_ESP32_SHARED_SECRET_2025
Esp32__TokenExpiryDays=365

# YOLO server URL (your Render deployment URL)
Yolo__BaseUrl=https://YOUR_RENDER_APP.onrender.com

# CORS — add your Vercel frontend URL
AllowedOrigins=https://YOUR_APP.vercel.app,http://localhost:3000

ASPNETCORE_ENVIRONMENT=Production
